{
  "datasets": [
    {
      "name": "55669d10",
      "displayName": "payment_performance",
      "config": {
        "version": "1.1",
        "source": "dev.gold.payment_performance",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "Total Payment Amount",
            "expr": "SUM(amount)",
            "displayName": "Total Payment Amount",
            "format": {
              "hideGroupSeparator": false,
              "decimalPlaces": {
                "type": "all"
              },
              "currencyCode": "INR",
              "type": "currency",
              "abbreviation": "none"
            }
          },
          {
            "name": "Payment Count",
            "expr": "COUNT(DISTINCT payment_id)",
            "displayName": "Payment Count"
          },
          {
            "name": "Successful Payment Count",
            "expr": "COUNT_IF(payment_status = 'Captured')",
            "displayName": "Successful Payment Count"
          },
          {
            "name": "Successful Payment Rate",
            "expr": "MEASURE(`Successful Payment Count`) / MEASURE(`Payment Count`)",
            "displayName": "Successful Payment Rate",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "all"
              },
              "hideGroupSeparator": false
            }
          }
        ]
      }
    },
